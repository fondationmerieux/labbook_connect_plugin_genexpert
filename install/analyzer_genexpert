# Analyzer Configuration File
# Contains general settings and connection details for one ROCHE analyzer.

version = "1.0.1"  # Configuration file version

[analyzer]
brand = "GENEXPERT"                   			# Analyzer brand
name = "GeneXpert"                    	 		# Analyzer model name
id = "GX1"                     			# Unique analyzer identifier
plugin = "AnalyzerGeneXpert"             	# Plugin Java class name for this analyzer
url_lis = "http://localhost/sigl"	# URL of the Laboratory Information System (LIS) upstream endpoint
operation_mode = "batch"          			# Operation mode (batch or query)
archive_msg = "Y"                 			# Enable ('Y') or disable ('N') message archiving
type_cnx = "socket"               			# Connection type (socket, ...)
type_msg = "ASTM"                  			# Message type (HL7 or ASTM)
mapping = "/storage/resource/connect/analyzer/mapping/mapping_genexpert.toml"  # Mapping configuration to use

[analyzer.socket]
mode = "server"                   # Socket mode (client or server)
ip = "192.168.1.52"        # Analyzer IP address
port = 12301       # Port number for socket communication